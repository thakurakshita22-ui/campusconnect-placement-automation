# CampusConnect Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database Mode: "demo" (default in local/FreeSQL environment) or "oracle"
DB_MODE=demo

# Oracle Database Configuration (Required only when DB_MODE=oracle)
# Example for local Oracle XE / Free:
# ORACLE_USER=placement_admin
# ORACLE_PASSWORD=YourSecurePassword123
# ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# Example for Oracle Cloud Autonomous Database / Wallet:
# ORACLE_USER=ADMIN
# ORACLE_PASSWORD=YourCloudPassword123
# ORACLE_CONNECT_STRING=campusdb_high
# TNS_ADMIN=/path/to/wallet_directory

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_LIB_DIR=
TNS_ADMIN=
